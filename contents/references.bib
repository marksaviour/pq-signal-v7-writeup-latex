@article{bhargavan_formal_2024,
	location = {Proc. 33rd {USENIX} Security Symposium},
	title = {Formal verification of the {PQXDH} Post-Quantum key agreement protocol for end-to-end secure messaging},
	url = {https://www.usenix.org/conference/usenixsecurity24/presentation/bhargavan},
	abstract = {The Signal Messenger recently introduced a new asynchronous key agreement protocol called {PQXDH} ({PostQuantum} Extended Diffie-Hellman) that seeks to provide post-quantum forward secrecy, in addition to the authentication and confidentiality guarantees already provided by the previous X3DH (Extended Diffie-Hellman) protocol. More precisely, {PQXDH} seeks to protect the confidentiality of messages against harvest-now-decrypt-later attacks. In this work, we formally specify the {PQXDH} protocol and analyze its security using two formal verification tools, {PROVERIF} and {CRYPTOVERIF}. In particular, we ask whether {PQXDH} preserves the guarantees of X3DH, whether it provides post-quantum forward secrecy, and whether it can be securely deployed alongside X3DH. Our analysis identifies several flaws and potential vulnerabilities in the {PQXDH} specification, although these vulnerabilities are not exploitable in the Signal application, thanks to specific implementation choices which we describe in this paper. To prove the security of the current implementation, our analysis notably highlighted the need for an additional binding property of the {KEM}, which we formally define and prove for Kyber.},
	author = {Bhargavan, Karthikeyan and Jacomme, Charlie and Kiefer, Franziskus and Schmidt, Rolfe},
	date = {2024},
	langid = {english},
	file = {PDF:/Users/marksaviour/Zotero/storage/5Q3XWH95/Bhargavan et al. - 2024 - Formal verification of the PQXDH Post-Quantum key agreement protocol for end-to-end secure messaging.pdf:application/pdf},
}

