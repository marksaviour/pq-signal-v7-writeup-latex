        </mxCell>
        <mxCell id="initMsg" edge="1" parent="O99PFMmOgphtmkXr0aQ--1" style="endArrow=block;html=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" value="Initial Message:&amp;nbsp; IK&lt;sub&gt;A&lt;/sub&gt;,&amp;nbsp; EK&lt;sub&gt;A&lt;/sub&gt;,&amp;nbsp; Identifiers of OPK&lt;sub&gt;B&lt;/sub&gt; and PQPK&lt;sub&gt;B&lt;/sub&gt;,&amp;nbsp; CT">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="154.5951859956236" y="402.23537234042556" as="sourcePoint" />
            <mxPoint x="746.3894967177242" y="403.9880319148936" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bobCompute" parent="O99PFMmOgphtmkXr0aQ--1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f7f7f7;strokeColor=#000000;fontSize=12;" value="&lt;b&gt;Bob Computes&lt;/b&gt;&lt;br&gt;- SS ← Decaps(sk&lt;sub&gt;PQPK_B&lt;/sub&gt;, CT)&lt;br&gt;- Recompute DH1 … DH4&lt;br&gt;&lt;b&gt;- SK = KDF(DH1 ∥ DH2 ∥ DH3 ∥ DH4 ∥ SS)&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- (same SK as Alice)&lt;/div&gt;" vertex="1">
          <mxGeometry height="106.9122340425532" width="305.2516411378556" x="594.7483588621444" y="445.1755319148936" as="geometry" />
        </mxCell>
        <mxCell id="hybridNote" parent="O99PFMmOgphtmkXr0aQ--1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#000000;dashed=1;fontSize=12;" value="&lt;b&gt;Hybrid Construction:&lt;/b&gt; SK depends on both the Curve25519 values DH1–DH4 and the KEM secret SS, so recovering SK requires defeating both the discrete-logarithm problem and the KEM. The output SK is handed to the Double Ratchet exactly as X3DH&#39;s output was." vertex="1">
          <mxGeometry height="66.60106382978724" width="590.8096280087527" x="155.57986870897156" y="592.3989361702128" as="geometry" />
        </mxCell>
