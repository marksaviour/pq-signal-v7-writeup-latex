        <mxCell id="aliceCompute" parent="O99PFMmOgphtmkXr0aQ--1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f7f7f7;strokeColor=#000000;fontSize=12;" value="&lt;b&gt;Alice Computes:&lt;/b&gt;&lt;br&gt;- Verify Sig(SPK&lt;sub&gt;B&lt;/sub&gt;) and Sig(PQPK&lt;sub&gt;B&lt;/sub&gt;)&lt;br&gt;- Generate Ephemeral Key Pair EK&lt;sub&gt;A&lt;/sub&gt;&lt;br&gt;- (CT, SS) ← Encaps(PQPK&lt;sub&gt;B&lt;/sub&gt;)&lt;br&gt;- DH1 … DH4 (as in X3DH)&lt;br&gt;&lt;b&gt;- SK = KDF(DH1 ∥ DH2 ∥ DH3 ∥ DH4 ∥ SS)&lt;/b&gt;" vertex="1">
