        <mxCell id="bobPublish" parent="O99PFMmOgphtmkXr0aQ--1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f7f7f7;strokeColor=#000000;fontSize=12;" value="&lt;b&gt;Publishes Extended Pre-Key Bundle&lt;/b&gt;&lt;br&gt;- IK&lt;sub&gt;B&lt;/sub&gt;,&amp;nbsp; SPK&lt;sub&gt;B&lt;/sub&gt; + Sig&lt;sub&gt;IK_B&lt;/sub&gt;(SPK&lt;sub&gt;B&lt;/sub&gt;),&amp;nbsp; {OPK&lt;sub&gt;B&lt;/sub&gt;},&lt;br&gt;- PQPK&lt;sub&gt;B&lt;/sub&gt; + Sig&lt;sub&gt;IK_B&lt;/sub&gt;(PQPK&lt;sub&gt;B&lt;/sub&gt;)&amp;nbsp;&amp;nbsp;(KEM public key)" vertex="1">
