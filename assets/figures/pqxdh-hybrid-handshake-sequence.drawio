        </mxCell>
        <mxCell id="fetchArrow" edge="1" parent="O99PFMmOgphtmkXr0aQ--1" style="endArrow=block;html=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" value="Fetches Extended Pre-Key Bundle">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="746.3894967177242" y="216.45345744680853" as="sourcePoint" />
            <mxPoint x="153.61050328227572" y="216.45345744680853" as="targetPoint" />
